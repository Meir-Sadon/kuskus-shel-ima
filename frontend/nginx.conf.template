server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # Pictures may be up to 5 MB; nginx would refuse anything over 1 MB by default.
    client_max_body_size 6m;

    # API calls go to the backend on the same origin, so the admin cookie stays first-party.
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Client-side routes (/login, /admin, ...) all load the app.
    location / {
        try_files $uri /index.html;
    }
}
